# Supabase proje adresi. Tarayıcıya da gider; gizli değildir.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co

# Supabase anon (publishable) anahtarı. Tarayıcıya gider. Service role anahtarını buraya yazmayın.
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Bilet QR imzası ve yarışma tur jetonu. En az 32 karakter, rastgele ve yalnızca sunucuda durmalı.
# Üretimde bu değişken yoksa bilet ve yarışma imzası hata verir. Yedek dize yoktur.
TICKET_SECRET=replace-with-a-long-random-secret

# İsteğe bağlı. Instagram Graph API jetonu. Tanımlıysa vitrin beş saatte bir bu hesaptan güncellenir.
# Video ve Reels kartları media_url ile Instagram CDN üzerinden oynar. Jeton yoksa veya video adresi gelmezse kapak görseli gösterilir.
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_USER_ID=

# İsteğe bağlı. Uygulama şu anda bu değişkeni okumaz; dağıtım adresi notu için bırakıldı.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
